{{ $hostname := .chezmoi.hostname }}
{{ if eq $hostname "aislingArch" }}
background_image {{ .chezmoi.homeDir }}/.config/kitty/hacknet.jpg
background_tint 0.8
{{ else }}
background_image {{ .chezmoi.homeDir }}/.config/kitty/hacknet4.jpg
background_tint 0.95
{{ end }}
background_image_layout cscaled
background_image_linear yes

initial_window_height   600
initial_window_width    860
remember_window_size    false
enable_audio_bell       no

confirm_os_window_close 0

# Allow the 240 Hz display to render at its full refresh rate without tearing
repaint_delay            4
sync_to_monitor          yes

tab_bar_edge            top
tab_bar_style           custom

font_size 11.0
disable_ligatures always

editor /usr/bin/nvim

#map ctrl+left resize_window narrower
#map ctrl+right resize_window wider
#map ctrl+up resize_window taller
#map ctrl+down resize_window shorter 3
## reset all windows in the tab to default sizes
#map ctrl+home resize_window reset
#map super+t new_tab
#mouse_map b5 press grabbed,ungrabbed next_tab
#mouse_map b4 press grabbed,ungrabbed previous_tab
#map super+e next_layout
#map super+w close_window
#map super+d new_window
#map f1 load_config_file

# BEGIN_KITTY_FONTS
font_family      family='NotoSansM Nerd Font Mono' style=Light
bold_font        auto
italic_font      family='NotoSansM Nerd Font Mono' style=Light
bold_italic_font auto
# END_KITTY_FONTS

# Programs may ask kitty to open a web link (kitten @ action open_url <url>), so
# the browser gets a Wayland activation token and comes to the front.
# open-url-only.py refuses every other remote control command. The socket
# (kitty-<pid> in the runtime dir, private to this user) works from inside tmux,
# which does not pass remote control replies back over the terminal.
allow_remote_control password
remote_control_password "" open-url-only.py
listen_on unix:${XDG_RUNTIME_DIR}/kitty
